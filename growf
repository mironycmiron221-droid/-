-- ✅ ПРОСТОЙ АВТОСБОР ДЛЯ GROW A GARDEN ПОД DELTA
-- ВСТАВЬ ЭТО ЦЕЛИКОМ В DELTA EXECUTOR И НАЖМИ EXECUTE

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

-- НАСТРОЙКИ
local FARM_ENABLED = true      -- автосбор вкл/выкл
local WALK_SPEED = 50          -- скорость ходьбы
local TELEPORT_DELAY = 0.1     -- задержка между тп
local SCAN_DELAY = 0.3         -- задержка, если нет фруктов

-- Под себя потом можешь поменять слова, если узнаем точные имена
local FRUIT_KEYWORDS = {
    "fruit",
    "apple",
    "banana",
    "berry",
    "melon",
    "straw",
    "grape"
}

---------------------------------------------------------------------
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
---------------------------------------------------------------------

local function isFruit(obj)
    if not obj:IsA("BasePart") then return false end
    local name = obj.Name:lower()
    for _, word in ipairs(FRUIT_KEYWORDS) do
        if name:find(word) then
            return true
        end
    end
    return false
end

local function getAllFruits()
    local fruits = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isFruit(obj) then
            table.insert(fruits, obj)
        end
    end
    return fruits
end

local function getClosestFruit()
    if not rootPart then return nil end

    local fruits = getAllFruits()
    local closest, closestDist

    for _, fruit in ipairs(fruits) do
        local dist = (fruit.Position - rootPart.Position).Magnitude
        if not closestDist or dist < closestDist then
            closestDist = dist
            closest = fruit
        end
    end

    return closest
end

local function teleportTo(part)
    if not part or not part.Parent then return end
    if not rootPart then return end

    rootPart.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
end

---------------------------------------------------------------------
-- ОСНОВНОЙ ЦИКЛ
---------------------------------------------------------------------

task.spawn(function()
    print("[GA Garden] Автофарм запущен, братан!")

    while true do
        if FARM_ENABLED and rootPart then
            local fruit = getClosestFruit()
            if fruit then
                teleportTo(fruit)
                -- Многие игры собирают по Touch, просто стоять на предмете уже достаточно
                -- Если тут нужен именно клик/промпт — подправим потом, когда узнаем структуру
                task.wait(TELEPORT_DELAY)
            else
                task.wait(SCAN_DELAY)
            end
        else
            task.wait(0.5)
        end
    end
end)

---------------------------------------------------------------------
-- РЕСПАВН
---------------------------------------------------------------------

local function onCharacterAdded(char)
    character = char
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)

    if hrp then
        rootPart = hrp
    end

    if hum then
        hum.WalkSpeed = WALK_SPEED
    end

    print("[GA Garden] Персонаж перезагружен, автофарм продолжается.")
end

player.CharacterAdded:Connect(onCharacterAdded)

---------------------------------------------------------------------
-- КОМАНДЫ ЧЕРЕЗ ЧАТ
---------------------------------------------------------------------

player.Chatted:Connect(function(msg)
    msg = msg:lower()
    if msg == "/farm on" then
        FARM_ENABLED = true
        print("[GA Garden] Автосбор ВКЛЮЧЕН.")
    elseif msg == "/farm off" then
        FARM_ENABLED = false
        print("[GA Garden] Автосбор ВЫКЛЮЧЕН.")
    end
end)

print("[GA Garden] Команды: /farm on и /farm off")
                           
