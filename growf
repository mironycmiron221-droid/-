-- Автосбор фруктов для Grow a Garden
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local collecting = true   -- включение/выключение автосбора
local autoSell = true     -- автопродажа при фарме
local speed = 50          -- скорость ходьбы

-- Функция для сбора фрукта
local function collectFruit(fruit)
    if not fruit or not fruit.Parent then return end

    local char = player.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Телепорт к фрукту с небольшим оффсетом по Y
    hrp.CFrame = fruit.CFrame * CFrame.new(0, 5, 0)
    task.wait(0.1)

    -- Пытаемся нажать ClickDetector, если он есть
    local cd = fruit:FindFirstChildOfClass("ClickDetector")
    if cd and fireclickdetector then
        pcall(function()
            fireclickdetector(cd)
        end)
    end
end

-- Поиск всех фруктов в workspace
local function findFruits()
    local fruits = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("fruit") or name:find("apple") or name:find("berry") or name:find("harvest") then
                table.insert(fruits, obj)
            end
        end
    end
    return fruits
end

-- Основной цикл автосбора
local connection
connection = RunService.Heartbeat:Connect(function()
    if not collecting then return end

    local fruits = findFruits()
    if #fruits > 0 then
        for _, fruit in ipairs(fruits) do
            collectFruit(fruit)
        end
    end

    -- Автопродажа
    if autoSell then
        local char = player.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local sellPart = workspace:FindFirstChild("SellShop") or workspace:FindFirstChild("Shop")
                if sellPart and sellPart:IsA("BasePart") then
                    hrp.CFrame = sellPart.CFrame + Vector3.new(0, 3, 0)
                    local cd = sellPart:FindFirstChildOfClass("ClickDetector")
                    if cd and fireclickdetector then
                        pcall(function()
                            fireclickdetector(cd)
                        end)
                    end
                end
            end
        end
    end
end)

-- Обработка респавна персонажа
local function onCharacterAdded(char)
    task.wait(1)
    local humanoid = char:WaitForChild("Humanoid")
    humanoid.WalkSpeed = speed
end

player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then
    onCharacterAdded(player.Character)
end

-- Команды для чата
player.Chatted:Connect(function(msg)
    msg = msg:lower()
    if msg == "/farm on" then
        collecting = true
        print("Автосбор включен!")
    elseif msg == "/farm off" then
        collecting = false
        print("Автосбор выключен!")
    end
end)

print("Автосбор фруктов запущен! /farm on и /farm off для управления, братан!")
