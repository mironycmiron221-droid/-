-- 🔥 УПРОЩЁННЫЙ АВТОФАРМ ДЛЯ GROW A GARDEN (НА ОСНОВЕ DEPTHSO)
-- ВСТАВЛЯЙ ЦЕЛИКОМ В DELTA, НИКАКИХ LOADSTRING НЕ НУЖНО

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

-- === НАСТРОЙКИ ===
local AUTO_PLANT = true      -- авто-посадка семян
local AUTO_HARVEST = true    -- авто-сбор растений
local AUTO_SELL = true       -- авто-продажа инвентаря
local PLANT_SEED_NAME = "Basic Seed"  -- имя семени (можно поменять)
local SELL_INTERVAL = 5      -- как часто продавать (секунд)

-- === РЕМОУТЫ, КАК В ПУБЛИЧНОМ СКРИПТЕ DEPTHSO === [web:52]
local GameEvents = ReplicatedStorage:WaitForChild("GameEvents")
local Plant_RE = GameEvents:WaitForChild("Plant_RE")              -- посадка
local Sell_Inventory = GameEvents:WaitForChild("Sell_Inventory")  -- продажа
local BuySeedStock = GameEvents:FindFirstChild("BuySeedStock")    -- покупка (на будущее)

-- Папки с фермой и растениями (по структуре depthso) [web:52]
local FarmFolder = workspace:WaitForChild("Farm")
local PlotsFolder = FarmFolder:WaitForChild("Plots")
local CropsFolder = FarmFolder:WaitForChild("Crops")

---------------------------------------------------------------------
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
---------------------------------------------------------------------

-- Получить список всех грядок
local function getAllPlots()
    local plots = {}
    for _, plot in ipairs(PlotsFolder:GetChildren()) do
        if plot:IsA("BasePart") or plot:IsA("Model") then
            table.insert(plots, plot)
        end
    end
    return plots
end

-- Проверка, свободна ли грядка (нет растения сверху)
local function isPlotFree(plot)
    if not plot or not plot.Parent then return false end
    -- depthso смотрит по Crops – мы просто проверим, нет ли растения с таким же ID [web:52]
    for _, crop in ipairs(CropsFolder:GetChildren()) do
        if crop:GetAttribute("PlotID") and plot:GetAttribute("PlotID") then
            if crop:GetAttribute("PlotID") == plot:GetAttribute("PlotID") then
                return false
            end
        end
    end
    return true
end

-- Посадить семя на грядку
local function plantOnPlot(plot)
    if not plot or not plot.Parent then return end
    -- В depthso Plant_RE принимает (plot, seedName) [web:52]
    Plant_RE:FireServer(plot, PLANT_SEED_NAME)
end

-- Проверка, созрело ли растение
local function isMature(crop)
    if not crop or not crop.Parent then return false end
    -- depthso использует атрибуты типа "GrowthStage" [web:52]
    local stage = crop:GetAttribute("GrowthStage")
    if stage and stage == "Mature" then
        return true
    end
    return false
end

-- Собрать растение
local function harvestCrop(crop)
    if not crop or not crop.Parent then return end
    -- В паблик-скрипте сбор идёт через ProximityPrompt / событие [web:52]
    local prompt = crop:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and fireproximityprompt then
        pcall(function()
            fireproximityprompt(prompt)
        end)
    end
end

-- Продать инвентарь
local function sellInventory()
    Sell_Inventory:FireServer()
end

---------------------------------------------------------------------
-- ЦИКЛ АВТО-ПОСАДКИ
---------------------------------------------------------------------

task.spawn(function()
    while true do
        if AUTO_PLANT then
            local plots = getAllPlots()
            for _, plot in ipairs(plots) do
                if isPlotFree(plot) then
                    plantOnPlot(plot)
                    task.wait(0.05)
                end
            end
        end
        task.wait(0.3)
    end
end)

---------------------------------------------------------------------
-- ЦИКЛ АВТО-СБОРА
---------------------------------------------------------------------

task.spawn(function()
    while true do
        if AUTO_HARVEST then
            for _, crop in ipairs(CropsFolder:GetChildren()) do
                if isMature(crop) then
                    harvestCrop(crop)
                    task.wait(0.05)
                end
            end
        end
        task.wait(0.2)
    end
end)

---------------------------------------------------------------------
-- ЦИКЛ АВТО-ПРОДАЖИ
---------------------------------------------------------------------

task.spawn(function()
    while true do
        if AUTO_SELL then
            sellInventory()
        end
        task.wait(SELL_INTERVAL)
    end
end)

