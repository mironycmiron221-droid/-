-- Авто-сбор фруктов для Grow a Garden
-- Кидай в LocalScript (для своей игры) или в исполнитель (для теста)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

local FARM_ENABLED = true          -- включение/выключение автосбора
local TELEPORT_DELAY = 0.1         -- задержка между тп к фруктам
local SCAN_DELAY = 0.3             -- задержка между поиском фруктов

-- Сюда впиши ключевые слова из названий фруктов в игре
-- Пример: "Apple", "Banana", "Strawberry" и т.д. [web:35][web:37]
local FRUIT_KEYWORDS = {
    "Fruit",
    "Apple",
    "Banana",
    "Berry",
    "Melon",
    "Strawberry",
    "Blueberry",
    "Grape"
}

-- Проверка, похоже ли имя объекта на фрукт
local function isFruit(obj)
    if not obj:IsA("BasePart") then return false end
    local name = obj.Name:lower()
    for _, word in ipairs(FRUIT_KEYWORDS) do
        if name:find(word:lower()) then
            return true
        end
    end
    return false
end

-- Поиск всех фруктов в workspace
local function getAllFruits()
    local fruits = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isFruit(obj) then
            table.insert(fruits, obj)
        end
    end
    return fruits
end

-- Получить ближайший фрукт к игроку
local function getClosestFruit()
    local fruits = getAllFruits()
    local closest, closestDist

    if not rootPart then return nil end

    for _, fruit in ipairs(fruits) do
        local dist = (fruit.Position - rootPart.Position).Magnitude
        if not closestDist or dist < closestDist then
            closestDist = dist
            closest = fruit
        end
    end

    return closest
end

-- Телепорт к фрукту
local function tpToFruit(fruit)
    if not fruit or not fruit.Parent then return end
    if not rootPart then return end

    -- Небольшой оффсет по Y, чтобы не застревать в деталях
    rootPart.CFrame = CFrame.new(fruit.Position + Vector3.new(0, 3, 0))
end

-- Основной цикл автосбора
task.spawn(function()
    while true do
        if FARM_ENABLED then
            local fruit = getClosestFruit()
            if fruit then
                tpToFruit(fruit)
                -- Если в игре сбор по touch — этого обычно хватает
                -- Если сбор кликом — можно добавить fireclickdetector, если есть ClickDetector
                local cd = fruit:FindFirstChildOfClass("ClickDetector")
                if cd then
                    pcall(function()
                        fireclickdetector(cd)
                    end)
                end
                task.wait(TELEPORT_DELAY)
            else
                -- Фруктов нет — подождём и поищем ещё
                task.wait(SCAN_DELAY)
            end
        else
            task.wait(0.5)
        end
    end
end)

-- Обработка респавна персонажа, чтобы не ломалось после смерти
player.CharacterAdded:Connect(function(char)
    character = char
    rootPart = char:WaitForChild("HumanoidRootPart")
end)

-- Небольшие чат-команды для удобства
player.Chatted:Connect(function(msg)
    msg = msg:lower()
    if msg == "/farm on" then
        FARM_ENABLED = true
        print("Автосбор включён, братан!")
    elseif msg == "/farm off" then
        FARM_ENABLED = false
        print("Автосбор выключен.")
    end
end)

print("Скрипт автосбора фруктов для Grow a Garden запущен! /farm on и /farm off для управления, бро.")
     
